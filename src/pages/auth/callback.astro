---
// File: src/pages/auth/callback.astro
// This page handles Netlify Identity callbacks (login, invite, etc.)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authenticating...</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #f8f6f3 0%, #ffffff 100%);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      .container {
        text-align: center;
      }
      h1 {
        color: #5a7d6b;
        margin-bottom: 10px;
      }
      p {
        color: #666;
      }
      a {
        color: #7fa66d;
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }
    </style>

    <!-- Netlify Identity Widget -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"
    ></script>

    <!-- Handle Auth Flow -->
    <script is:inline>
      // This runs immediately
      window.netlifyIdentity = window.netlifyIdentity || {};

      window.netlifyIdentity.on("init", function (user) {
        if (user) {
          // User already logged in, redirect to admin
          window.location.href = "/admin/";
        }
      });

      window.netlifyIdentity.on("login", function (user) {
        // After login, go to admin
        window.location.href = "/admin/";
      });

      window.netlifyIdentity.on("logout", function () {
        // After logout, go home
        window.location.href = "/";
      });

      // Initialize the widget
      window.netlifyIdentity.init();
    </script>
  </head>

  <body>
    <div class="container">
      <h1>Authenticating...</h1>
      <p>Please wait while we set up your account.</p>
      <p>
        If you're not redirected in a few seconds, <a href="/admin/"
          >click here</a
        >.
      </p>
    </div>
  </body>
</html>
